# COPY TO .env.staging locally; on Render enter these in Environment.
# This example has no real credentials. Never commit the filled file.
DJANGO_SETTINGS_MODULE=config.settings_staging
DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=require
# Required for local administrative commands; Render supplies its exact hostname.
STAGING_ALLOWED_HOSTS=YOUR-SERVICE.onrender.com
MINIAPP_PUBLIC_URL=https://YOUR-SERVICE.onrender.com
MINIAPP_BOT_USERNAME=bmmsev_bot
TELEGRAM_BOT_TOKEN=
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.YOUR-NEON-REGION.aws.neon.tech
AWS_REGION=eu-central-1
AWS_STORAGE_BUCKET_NAME=bm-staging-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Keep 0 until the isolated checkout and closed group have been verified.
STAGING_PICKUP_ENABLED=0
MINIAPP_ORDERS_ENABLED=0
TELEGRAM_NOTIFICATIONS_ENABLED=0
# Numeric closed employee group ID; server only. No real value in Git.
TELEGRAM_ADMIN_CHAT_ID=
# Optional separate test group for check_order_chat, never used for new orders.
TELEGRAM_TEST_CHAT_ID=
# Optional staff confirmation: configure only after an approved webhook setup.
TELEGRAM_ORDER_WEBHOOK_ENABLED=0
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ORDER_STAFF_IDS=
# Existing permanent origin, for links from staff notifications to the private Admin.
MINIAPP_ADMIN_URL=https://YOUR-SERVICE.onrender.com
MINIAPP_WEIGHT_ESTIMATE=1
