{
  "name": "bolshoy-myasnoy-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tunnel:serve": "vite preview --host 127.0.0.1 --port 5174 --strictPort --mode tunnel",
    "test": "vitest run",
    "format": "prettier --write src tunnel vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "glisse": "0.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "prettier": "^3.4.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
